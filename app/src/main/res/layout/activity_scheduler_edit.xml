<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部工具栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="#FF6B35"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="horizontal"
            android:elevation="4dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:paddingEnd="16dp"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="编辑定时任务"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 时间选择卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="执行时间"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2D2D2D" />

                    <TimePicker
                        android:id="@+id/timePicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:timePickerMode="spinner" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 动作选择卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="执行动作"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2D2D2D" />

                    <RadioGroup
                        android:id="@+id/radioGroupAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp">

                        <RadioButton
                            android:id="@+id/radioOn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="开灯"
                            android:checked="true"
                            android:textColor="#4CAF50" />

                        <RadioButton
                            android:id="@+id/radioOff"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="关灯"
                            android:textColor="#E64A19" />

                    </RadioGroup>

                    <!-- 亮度选择 -->
                    <LinearLayout
                        android:id="@+id/layoutBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="亮度"
                            android:textSize="14sp"
                            android:textColor="#2D2D2D" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:id="@+id/seekBarBrightness"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="100"
                                android:progress="100" />

                            <TextView
                                android:id="@+id/tvBrightnessValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#FF6B35"
                                android:paddingStart="8dp" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 重复规则卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="重复规则"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2D2D2D" />

                    <!-- 快捷选择 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp">

                        <Button
                            android:id="@+id/btnRepeatEveryDay"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="每天"
                            android:textSize="12sp"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            style="@style/Widget.AppCompat.Button.Borderless" />

                        <Button
                            android:id="@+id/btnRepeatWeekday"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="工作日"
                            android:textSize="12sp"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            style="@style/Widget.AppCompat.Button.Borderless" />

                        <Button
                            android:id="@+id/btnRepeatWeekend"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="周末"
                            android:textSize="12sp"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            style="@style/Widget.AppCompat.Button.Borderless" />

                        <Button
                            android:id="@+id/btnRepeatOnce"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="一次性"
                            android:textSize="12sp"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            style="@style/Widget.AppCompat.Button.Borderless" />

                    </LinearLayout>

                    <!-- 星期选择 -->
                    <LinearLayout
                        android:id="@+id/layoutWeekdays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:gravity="center">

                        <CheckBox android:id="@+id/cbSun" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="日" android:textSize="12sp" />
                        <CheckBox android:id="@+id/cbMon" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="一" android:textSize="12sp" />
                        <CheckBox android:id="@+id/cbTue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="二" android:textSize="12sp" />
                        <CheckBox android:id="@+id/cbWed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="三" android:textSize="12sp" />
                        <CheckBox android:id="@+id/cbThu" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="四" android:textSize="12sp" />
                        <CheckBox android:id="@+id/cbFri" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="五" android:textSize="12sp" />
                        <CheckBox android:id="@+id/cbSat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="六" android:textSize="12sp" />

                    </LinearLayout>

                    <!-- 日期选择 -->
                    <LinearLayout
                        android:id="@+id/layoutDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="执行日期"
                            android:textSize="14sp"
                            android:textColor="#2D2D2D" />

                        <DatePicker
                            android:id="@+id/datePicker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:calendarViewShown="false"
                            android:datePickerMode="spinner" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 启用开关卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="启用此任务"
                        android:textSize="15sp"
                        android:textColor="#2D2D2D" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 保存按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="取消"
                    android:textColor="#6B7280"
                    style="@style/Widget.AppCompat.Button.Borderless" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="保存"
                    android:backgroundTint="#FF6B35"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
