<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="24sp"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="编辑定时任务"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 时间选择卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="执行时间"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#424242" />

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 动作选择卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="执行动作"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#424242" />

                <RadioGroup
                    android:id="@+id/radioGroupAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <RadioButton
                        android:id="@+id/radioOn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开灯"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/radioOff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="关灯" />
                </RadioGroup>

                <!-- 亮度选择 -->
                <LinearLayout
                    android:id="@+id/layoutBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="亮度"
                        android:textSize="14sp"
                        android:textColor="#424242" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekBarBrightness"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="100" />

                        <TextView
                            android:id="@+id/tvBrightnessValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textSize="14sp"
                            android:paddingStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 重复规则卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重复规则"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#424242" />

                <!-- 快捷选择 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <Button
                        android:id="@+id/btnRepeatEveryDay"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="每天"
                        android:textSize="12sp"
                        style="@style/Widget.AppCompat.Button.Borderless" />

                    <Button
                        android:id="@+id/btnRepeatWeekday"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="工作日"
                        android:textSize="12sp"
                        style="@style/Widget.AppCompat.Button.Borderless" />

                    <Button
                        android:id="@+id/btnRepeatWeekend"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="周末"
                        android:textSize="12sp"
                        style="@style/Widget.AppCompat.Button.Borderless" />

                    <Button
                        android:id="@+id/btnRepeatOnce"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="一次性"
                        android:textSize="12sp"
                        style="@style/Widget.AppCompat.Button.Borderless" />
                </LinearLayout>

                <!-- 星期选择 -->
                <LinearLayout
                    android:id="@+id/layoutWeekdays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:gravity="center">

                    <CheckBox android:id="@+id/cbSun" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="日" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/cbMon" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="一" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/cbTue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="二" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/cbWed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="三" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/cbThu" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="四" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/cbFri" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="五" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/cbSat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="六" android:textSize="12sp"/>
                </LinearLayout>

                <!-- 日期选择（一次性任务） -->
                <LinearLayout
                    android:id="@+id/layoutDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="执行日期"
                        android:textSize="14sp"
                        android:textColor="#424242" />

                    <DatePicker
                        android:id="@+id/datePicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:calendarViewShown="false"
                        android:datePickerMode="spinner" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 启用开关卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用此任务"
                    android:textSize="14sp"
                    android:textColor="#424242" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 保存按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="取消"
                style="@style/Widget.AppCompat.Button.Borderless" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="保存"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
