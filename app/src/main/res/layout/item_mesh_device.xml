<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?android:attr/selectableItemBackground"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 左侧：在线状态 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_gravity="center_vertical">

                <!-- 在线状态 -->
                <LinearLayout
                    android:id="@+id/layoutOnlineIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <View
                        android:id="@+id/viewOnlineDot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="#4CAF50" />

                    <TextView
                        android:id="@+id/tvOnlineText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="在线"
                        android:textSize="10sp"
                        android:textColor="#4CAF50"
                        android:layout_marginStart="3dp" />

                </LinearLayout>

                <!-- 分组名称 -->
                <TextView
                    android:id="@+id/tvDeviceGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="卧室"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- 右侧：图标 + 设备名 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/icon_circle_bg">

                    <ImageView
                        android:id="@+id/ivDeviceIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_device_light"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="灯 1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2D2D2D"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- 亮度控制条 -->
        <LinearLayout
            android:id="@+id/layoutQuickBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarQuickBrightness"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:splitTrack="false" />

            <TextView
                android:id="@+id/tvBrightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textSize="10sp"
                android:textColor="#FF6B35"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:minWidth="32dp"
                android:gravity="end" />

        </LinearLayout>

        <!-- 底部：定时按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#F8F9FA">

            <TextView
                android:id="@+id/btnQuickTimer"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⏱ 定时"
                android:textSize="10sp"
                android:textColor="#6B7280"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#E5E7EB" />

            <TextView
                android:id="@+id/btnQuickGroup"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔗 分组"
                android:textSize="10sp"
                android:textColor="#6B7280"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- 隐藏的状态图标（保留兼容） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLightStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvScheduleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 隐藏的温度（保留兼容） -->
        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
