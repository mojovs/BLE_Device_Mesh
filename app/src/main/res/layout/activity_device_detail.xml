<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:textSize="16sp"
            android:textColor="#2196F3"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设备详情"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⋮"
            android:textSize="22sp"
            android:textColor="#333333"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 连接状态卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerConnection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="连接状态"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/iconConnection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⌄"
                            android:textSize="16sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyConnection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Spinner
                                android:id="@+id/spinnerProxyAddress"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/spinner_background"
                                android:spinnerMode="dropdown"/>

                            <Button
                                android:id="@+id/btnScanProxy"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="扫描"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:layout_marginEnd="8dp"/>

                            <Button
                                android:id="@+id/btnConnect"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="断开"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/btnAutoConnect"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="6dp"
                            android:text="自动连接"
                            android:textSize="14sp"
                            android:backgroundTint="#FF9800"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvConnectionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未连接"
                                android:textSize="11sp"
                                android:textColor="#999999"/>

                            <TextView
                                android:id="@+id/tvSignalStrength"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="📶"
                                android:textSize="14sp"
                                android:visibility="gone"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 设备信息卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerDeviceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="设备信息"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/iconDeviceInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⌄"
                            android:textSize="16sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyDeviceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tvDeviceInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="名称: 客厅灯\n地址: 0x0005\n类型: 灯光"
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="控制地址 (Group)："
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/etGroupAddress"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:hint="例如: 0x0200"
                                android:textSize="12sp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:background="@drawable/spinner_background"
                                android:inputType="text"
                                android:layout_marginEnd="8dp"/>

                            <Button
                                android:id="@+id/btnSaveGroupAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="保存"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:backgroundTint="#4CAF50"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="选择设备 MAC 地址："
                            android:textSize="11sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="6dp"/>

                        <Spinner
                            android:id="@+id/spinnerDeviceMac"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/spinner_background"
                            android:spinnerMode="dropdown"/>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 亮度控制卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="亮度控制"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/tvBrightnessValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="50%"
                            android:textSize="16sp"
                            android:textColor="#2196F3"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/iconBrightness"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⌄"
                            android:textSize="20sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnBrightnessDown"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="−"
                                android:textSize="24sp"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"/>

                            <SeekBar
                                android:id="@+id/seekBarBrightness"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:max="100"
                                android:progress="50"/>

                            <Button
                                android:id="@+id/btnBrightnessUp"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="+"
                                android:textSize="24sp"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 光线亮度卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerLightLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="光线亮度"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/tvLightLevelValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="-- lux"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FF9800"/>

                        <TextView
                            android:id="@+id/iconLightLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyLightLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btnRefreshLightLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="刷新光照"
                            android:backgroundTint="#FF9800"
                            android:textColor="@android:color/white"/>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 温度监控卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="温度监控"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/tvTemperatureValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="-- °C"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FF5722"/>

                        <TextView
                            android:id="@+id/iconTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyTemperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btnRefreshTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="刷新温度"
                            android:backgroundTint="#FF5722"
                            android:textColor="@android:color/white"/>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 时间同步卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="时间同步"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/iconTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodyTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvDeviceTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="设备时间: --"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnReadTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="读取时间"
                                android:backgroundTint="#4CAF50"/>

                            <Button
                                android:id="@+id/btnSyncTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="同步时间"
                                android:backgroundTint="#2196F3"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 定时开关卡片（灯光设备） -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="定时开关"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:id="@+id/iconSchedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#AAAAAA"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bodySchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <!-- 定时开机 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="定时开机"
                                android:textSize="14sp"
                                android:textColor="#333333"/>

                            <TextView
                                android:id="@+id/tvOnTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未设置"
                                android:textSize="14sp"
                                android:textColor="#2196F3"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/tvOnRepeat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="每天"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:background="#2196F3"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginEnd="6dp"/>

                            <Button
                                android:id="@+id/btnSetOnTime"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="设置"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:layout_marginEnd="4dp"
                                android:backgroundTint="#4CAF50"/>

                            <Button
                                android:id="@+id/btnClearOnTime"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="清除"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:backgroundTint="#9E9E9E"/>
                        </LinearLayout>

                        <!-- 定时关机 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="定时关机"
                                android:textSize="14sp"
                                android:textColor="#333333"/>

                            <TextView
                                android:id="@+id/tvOffTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未设置"
                                android:textSize="14sp"
                                android:textColor="#FF5722"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/tvOffRepeat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="每天"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:background="#FF5722"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginEnd="6dp"/>

                            <Button
                                android:id="@+id/btnSetOffTime"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="设置"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:layout_marginEnd="4dp"
                                android:backgroundTint="#FF5722"/>

                            <Button
                                android:id="@+id/btnClearOffTime"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="清除"
                                android:textSize="12sp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:backgroundTint="#9E9E9E"/>
                        </LinearLayout>

                        <!-- 分隔线 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"/>

                        <!-- Scheduler 模型读取 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备计划状态"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <Button
                                android:id="@+id/btnReadScheduler"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="读取计划"
                                android:textSize="13sp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:backgroundTint="#9C27B0"/>

                            <TextView
                                android:id="@+id/tvSchedulerStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="未读取"
                                android:textSize="13sp"
                                android:textColor="#666666"
                                android:layout_marginStart="12dp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSchedulerDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:visibility="gone"
                            android:background="#F5F5F5"
                            android:padding="8dp"/>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 状态信息 -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: 未连接"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
