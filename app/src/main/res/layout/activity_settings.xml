<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF5F0">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="#FF6B35"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Mesh 配置区块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mesh 网络配置"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <Button
                            android:id="@+id/btnImportConfig"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="导入 Mesh 配置 (Json)"
                            android:textSize="14sp"
                            android:backgroundTint="#FF6B35"
                            android:textColor="#FFFFFF" />

                        <Button
                            android:id="@+id/btnExportConfig"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="导出 Mesh 配置 (Json)"
                            android:textSize="14sp"
                            android:backgroundTint="#1976D2"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvConfigStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="未导入配置"
                            android:textSize="13sp"
                            android:textColor="#6B7280" />

                        <TextView
                            android:id="@+id/tvProvisionerAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Provisioner 地址: --"
                            android:textSize="12sp"
                            android:textColor="#FF9800" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Proxy 连接区块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxy 节点"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自动连接到 Proxy"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2D2D2D" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="启动时自动连接到最近的 Proxy 节点"
                            android:textSize="12sp"
                            android:textColor="#6B7280" />

                        <Switch
                            android:id="@+id/switchAutoConnect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="启用自动连接"
                            android:checked="true" />

                        <Button
                            android:id="@+id/btnScanProxy"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:text="扫描 Proxy 节点"
                            android:textSize="14sp"
                            android:backgroundTint="#FF6B35"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvProxyStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="未连接"
                            android:textSize="13sp"
                            android:textColor="#6B7280" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
